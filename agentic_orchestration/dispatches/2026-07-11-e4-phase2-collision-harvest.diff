+    def __init__(self, x: float, y: float, heading_rad: float):
+        self.x = x
+        self.y = y
+        self.heading_rad = heading_rad
+
+    def distance_to(self, other) -> float:
+        return math.hypot(other.x - self.x, other.y - self.y)
+
