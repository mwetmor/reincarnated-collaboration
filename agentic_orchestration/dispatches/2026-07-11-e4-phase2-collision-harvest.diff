+class _PosProbe:
+    """A minimal position/heading stand-in reusing the _compute_*_hits geometry tests.
+
+    E4 (2026-07-11): the pilot-floor template check + the fixed-footprint channel tick need to
+    hit-test a footprint anchored at a projected point / a cached origin, WITHOUT mutating the
+    real attacker. A _PosProbe carries only (.x, .y, .heading_rad) + .distance_to, which is the
+    entire surface _compute_circle/cone/line_hits reads on the attacker — so the SAME geometry
+    that resolves damage resolves the probe (no drift; math note §3.1/§2.3)."""
+    __slots__ = ("x", "y", "heading_rad")
