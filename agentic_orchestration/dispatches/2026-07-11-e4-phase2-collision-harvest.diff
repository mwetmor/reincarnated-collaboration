+from pathlib import Path
+
+_ORACLE = Path(__file__).resolve().parents[1] / "output" / "e4_byte_identity_golden_2026_07_11.json"
+
+_SCENARIOS = ["open_arena", "chokepoint_corridor", "boss_with_adds", "elite_pack"]
+_N_FIGHTS = 4
+_SEED = 57000  # deterministic
+
+
+def _run_population() -> dict:
+    """Run a small deterministic snap-grade population and fingerprint every fight result.
+
+    Uses the PRODUCTION path (player_class) so resolver-mitigated damage is exercised (the real
+    balance path), not the projection flat-fallback. The fingerprint is the observable surface a
+    downstream consumer sees; byte-identity of it across trees is the guard."""
+    import logging
+    logging.disable(logging.CRITICAL)
+    from reincarnated.generation.season_generation_pipeline import (
+        w5r1_generate_kit_candidates, _build_real_player_class,
+    )
+    from reincarnated.generation.resource_economy import DEFAULT_RESOURCE_ECONOMY
+    from reincarnated.simulation.spatial_gauntlet.spatial_engine import run_spatial_fight
+    from reincarnated.simulation.spatial_gauntlet.arena import ALL_SCENARIOS
+    from reincarnated.simulation.gauntlet_four_family_metrology_driver import _build_standard_mob_dicts
+
+    kits = w5r1_generate_kit_candidates(seed_base=57000000)
+    # a stable slice of 3 kits (deterministic order)
+    kits = kits[:3]
+
+    fp: dict = {}
+    for kit in kits:
+        player_class = _build_real_player_class(kit)   # KitCandidate → production PlayerClass
+        class_dict = player_class.model_dump()
+        class_dict["resource_economy"] = dict(DEFAULT_RESOURCE_ECONOMY)
+        for sid in _SCENARIOS:
+            scenario = ALL_SCENARIOS[sid]
+            mob_dicts = _build_standard_mob_dicts(scenario)
+            raw = run_spatial_fight(
+                scenario=scenario, class_dict=class_dict, mob_dicts=mob_dicts,
+                n_fights=_N_FIGHTS, session_id="e4_bi_ab", base_seed=_SEED,
+                season_id="e4-byte-identity", player_class=player_class, damage_modifier=1.0,
+            )
+            rows = []
+            for r in raw["fight_results"]:
+                rows.append([
+                    r.winner,
+                    round(r.elapsed_s, 6),
+                    r.player_kill,
+                    r.mobs_killed,
+                    round(r.player_damage_total, 4),
+                    round(r.damage_to_boss, 4),
+                    round(r.total_displacement, 6),
+                    r.player_death_element,
+                ])
+            fp[f"{kit.character_id}|{sid}"] = rows
+    return fp
+
+
+def _perf_fps() -> float:
+    """Measure fights/s on a representative gauntlet slice (perf criterion 19)."""
+    import logging
+    logging.disable(logging.CRITICAL)
+    from reincarnated.generation.season_generation_pipeline import (
+        w5r1_generate_kit_candidates, _build_real_player_class,
+    )
+    from reincarnated.generation.resource_economy import DEFAULT_RESOURCE_ECONOMY
+    from reincarnated.simulation.spatial_gauntlet.spatial_engine import run_spatial_fight
+    from reincarnated.simulation.spatial_gauntlet.arena import ALL_SCENARIOS
+    from reincarnated.simulation.gauntlet_four_family_metrology_driver import _build_standard_mob_dicts
+
+    player_class = _build_real_player_class(w5r1_generate_kit_candidates(seed_base=57000000)[0])
+    class_dict = player_class.model_dump()
+    class_dict["resource_economy"] = dict(DEFAULT_RESOURCE_ECONOMY)
+    scenario = ALL_SCENARIOS["open_arena"]
+    mob_dicts = _build_standard_mob_dicts(scenario)
+    N = 40
+    t0 = time.perf_counter()
+    run_spatial_fight(
+        scenario=scenario, class_dict=class_dict, mob_dicts=mob_dicts, n_fights=N,
+        session_id="e4_perf", base_seed=_SEED, season_id="e4-perf", player_class=player_class,
+        damage_modifier=1.0,
+    )
+    dt = time.perf_counter() - t0
+    return N / dt if dt > 0 else float("inf")
+
+
+def capture() -> int:
+    fp = _run_population()
+    fps = _perf_fps()
+    _ORACLE.parent.mkdir(parents=True, exist_ok=True)
+    _ORACLE.write_text(json.dumps({"fingerprint": fp, "perf_fps": fps}, indent=2, sort_keys=True))
+    print(f"[CAPTURE] golden written: {_ORACLE}")
+    print(f"[CAPTURE] {len(fp)} (kit,scenario) cells; baseline perf {fps:.1f} fights/s")
+    return 0
+
+
+def verify() -> int:
+    if not _ORACLE.exists():
+        print(f"[VERIFY] no golden at {_ORACLE} — run `capture` on the PRE-E4 tree first.")
+        return 2
+    golden = json.loads(_ORACLE.read_text())
+    fp_now = _run_population()
+    fp_old = golden["fingerprint"]
+
+    ok = True
+    keys = set(fp_old) | set(fp_now)
+    for k in sorted(keys):
+        if fp_old.get(k) != fp_now.get(k):
+            ok = False
+            print(f"[VERIFY] DIVERGENCE at {k}:")
+            print(f"    pre-E4 : {fp_old.get(k)}")
+            print(f"    E4     : {fp_now.get(k)}")
+    if ok:
+        print(f"[VERIFY] byte-identity: PASS — {len(fp_now)} (kit,scenario) cells identical "
+              f"to the pre-E4 tree. Snap-grade population UNCHANGED by construction.")
+
+    # PERF gate (criterion 19): ≥30 fights/s; regression >17% blocks.
+    fps_now = _perf_fps()
+    fps_old = float(golden.get("perf_fps", 0.0))
+    print(f"[VERIFY] perf: pre-E4 {fps_old:.1f} fights/s → E4 {fps_now:.1f} fights/s")
+    perf_ok = fps_now >= 30.0 and (fps_old <= 0 or fps_now >= 0.83 * fps_old)
+    if not perf_ok:
+        print(f"[VERIFY] PERF GATE: BLOCK (need ≥30 fights/s AND ≥0.83×baseline "
+              f"{0.83*fps_old:.1f}; got {fps_now:.1f})")
+    else:
+        print(f"[VERIFY] PERF GATE: PASS (≥30 fights/s; regression "
+              f"{100*(1 - fps_now/fps_old) if fps_old>0 else 0:.1f}% ≤ 17%)")
+
+    if ok and perf_ok:
+        print("RESULT: BYTE-IDENTICAL + PERF PASS")
+        return 0
+    print("RESULT: FAIL")
+    return 1
+
+
+def main(argv: list[str]) -> int:
+    cmd = argv[1] if len(argv) > 1 else "verify"
+    if cmd == "capture":
+        return capture()
+    return verify()
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv))
