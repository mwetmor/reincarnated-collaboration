+def _point_in_template(attacker, px: float, py: float, skill: dict, geo: str) -> bool:
+    """Would a target at (px, py) fall inside the attacker's CURRENT footprint? (E4 §3.1).
+
+    Used by the pilot-competence floor: initiate a wind-up ONLY when the projected target
+    position at completion is in-template. Reuses the resolution geometry via a single-target
+    probe list so the floor tests the SAME footprint the resolution will (no projection/
+    resolution split — the calibration-honesty requirement, math note §3.1)."""
+    tgt = _PosProbe(px, py, 0.0)
