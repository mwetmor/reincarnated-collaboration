+"""
+E4 commitment-axis — the cast-state machine (PHASE-2 sim consumer).
+
+gamora, 2026-07-11 (gamora/v-commitment-axis-4). Math note:
+    simulation/math/commitment-axis-e4-sim-consumer-2026-07-11.md
+
+This module is the SIM CONSUMER of the E4 v2 packet contract (rocket emitter half
+`e4d682e`; skill_schema.py commitment fields). It HONORS the emitted calibrated
+constants AS-EMITTED (cast_time, tick_interval, Y%/W, lockout, ramp, drain,
+commitment_premium) — it does NOT re-derive them (dispatch §2.3; re-derivation is
+seam drift). The premium already rides on the emitted damage_multiplier; this module
+never touches it.
+
+Design law it makes REAL (addendum §B/§C):
+  - wind-up:  idle -> committing(cast_time) -> resolve-at-completion (motion-whiff).
+  - channel:  idle -> channeling(tick loop) -> released | broken | exhausted.
+  - snap / exempt: degenerate (no state; byte-identical to pre-E4).
+
+Integration: spatial_engine's player-action phase delegates the commitment decision
+to `plan_player_action(...)`; the per-tick channel service delegates to
+`service_channel_tick(...)`. The whiff/tick RESOLUTION (hit-test + damage apply) stays
+in the engine (it needs engine-local closures over _compute_aoe_hits / _apply_skill_damage);
+this module owns the STATE + PARSING + the pilot-floor PROJECTION so they are unit-testable
+in isolation.
+
+NO velocity field exists on SpatialEntity (co-sign §13.7) — the pilot floor
+FORWARD-INTEGRATES the same per-tick mob motion model over the cast window.
+"""
+
+from __future__ import annotations
+
+import math
+from dataclasses import dataclass
+from typing import Optional
+
+
+# ── The three bins (D7-clean; genre-precedented) ──────────────────────────────
+BIN_SNAP = "snap"
+BIN_WINDUP = "wind-up"
+BIN_CHANNEL = "channel"
+
+# Degenerate cast-time floor for snap so the machine has a non-degenerate but
+# negligible window (math note §3.1 — emitter value, honored). Used only as a
+# defensive fallback if a snap slot carries no cast_time.
+_SNAP_CAST_TIME_FALLBACK = 0.15
+
+
+@dataclass
+class Commitment:
+    """The parsed [M] mechanical subset of one skill's E4 packet (skill_schema.py v2).
+
+    None `bin` == exempt slot (no layer) -> the machine never leaves idle -> the
+    engine takes the pre-E4 instant-resolve path. Every field is read via `.get`
+    so a pre-E4 packet (all fields absent) parses to an EXEMPT commitment.
+    """
+    bin: Optional[str]
+    cast_time: float
+    # channel sub-fields (non-null only when bin == channel)
+    tick_interval_s: float
+    ramp_floor: float
+    ramp_n_ticks: int
+    forced_break_pct: float
+    forced_break_window_s: float
+    forced_break_lockout_s: float
+    drain_rate: float
+    tick_tracking: str            # "tracking" | "fixed"
+    move_policy: str              # "rooted" | "walk" | "full_move"
+    move_policy_walk_pct: float
+    pay_on_commit: bool
+
+    @property
+    def is_exempt(self) -> bool:
+        return self.bin is None
+
+    @property
+    def is_windup(self) -> bool:
+        return self.bin == BIN_WINDUP
+
+    @property
+    def is_channel(self) -> bool:
+        return self.bin == BIN_CHANNEL
+
+    @property
+    def is_snap(self) -> bool:
+        return self.bin == BIN_SNAP
+
+
+def read_commitment(skill: dict) -> Commitment:
+    """Parse the [M] packet fields off a skill dict (Skill.model_dump()).
+
+    Pure `.get`-based read: a pre-E4 / exempt skill (no commitment fields) yields
+    a Commitment with bin=None (exempt), which the engine treats as the degenerate
+    instant path — byte-identical to pre-E4.
+    """
+    _bin = skill.get("commitment_bin")  # None on exempt / pre-E4 slots
+    # cast_time: emitted value (READ now). Fallbacks are defensive only.
+    _ct = skill.get("cast_time")
+    if _ct is None:
+        _ct = _SNAP_CAST_TIME_FALLBACK if _bin == BIN_SNAP else 0.0
+    return Commitment(
+        bin=_bin,
+        cast_time=float(_ct),
+        tick_interval_s=float(skill.get("tick_interval_seconds") or 0.35),
+        ramp_floor=float(skill.get("ramp_floor") if skill.get("ramp_floor") is not None else 0.5),
+        ramp_n_ticks=int(skill.get("ramp_n_ticks") or 6),
+        forced_break_pct=float(skill.get("forced_break_pct") if skill.get("forced_break_pct") is not None else 0.20),
+        forced_break_window_s=float(skill.get("forced_break_window_s") or 1.0),
+        forced_break_lockout_s=float(skill.get("forced_break_lockout_s") or 0.4),
+        drain_rate=float(skill.get("drain_rate") or 0.0),
+        tick_tracking=str(skill.get("tick_tracking") or "tracking"),
+        move_policy=str(skill.get("move_policy") or "rooted"),
+        move_policy_walk_pct=float(skill.get("move_policy_walk_pct") or 0.5),
+        pay_on_commit=bool(skill.get("pay_on_commit") if skill.get("pay_on_commit") is not None else True),
+    )
+
+
+def ramp(tick_n: int, floor: float, n_ticks: int) -> float:
+    """Channel ramp reward multiplier (F-2b; math note §6.3, honored AS-EMITTED).
+
+    ramp(n) = min(1.0, floor + (1 - floor) * (n / n_ticks)); plateau at n >= n_ticks.
+    A break/reset sets tick_n -> 0, so re-initiating re-climbs from ramp(0) -> this is
+    the teeth (§2.4).
+    """
+    if n_ticks <= 0:
+        return 1.0
+    return min(1.0, floor + (1.0 - floor) * (float(tick_n) / float(n_ticks)))
+
+
+# ── Pilot-competence floor v1 (F-competence; addendum §C.4; §3) ───────────────
+# The sim stores NO velocity vector (co-sign §13.7). The floor FORWARD-INTEGRATES
+# the SAME per-tick mob motion model over the cast window so it projects the same
+# trajectory the world moves on (a projection/resolution split would bias c_wind).
+
+def _one_step_mob_motion(
+    mx: float, my: float,
+    mspeed: float,
+    behavior: str,
+    preferred_range_m: float,
+    px: float, py: float,
+    dt: float,
+) -> tuple[float, float]:
+    """One tick of the mob motion model (mirrors _navigate_entity's non-leash,
+    non-serial branches at spatial_engine.py:1123-1177) toward the player at (px,py).
+
+    Competent-not-clairvoyant: the floor knows the MODEL (behavior + speed + player
+    position), not the RNG. It reproduces the ranged_kite / hit_and_run / cast_at_range
+    / melee branches — the mobility regimes that cause whiffs. Arena clamp is NOT applied
+    (the projection is a position estimate, not a state mutation; clamp only tightens it).
+    """
+    pdist = math.hypot(px - mx, py - my)
+
+    if behavior == "stationary_caster":
+        return (mx, my)  # does not move
+
+    if behavior in ("melee_aggressive", "charge_then_melee"):
+        tx, ty = px, py
+    elif behavior == "ranged_kite":
+        if pdist < preferred_range_m and pdist > 0.01:
+            scale = preferred_range_m / pdist
+            tx = px + (mx - px) * scale
+            ty = py + (my - py) * scale
+        else:
+            tx, ty = mx, my  # hold
+    elif behavior == "cast_at_range":
+        if pdist > preferred_range_m:
+            tx, ty = px, py
+        else:
+            tx, ty = mx, my  # hold
+    elif behavior == "hit_and_run":
+        if pdist < preferred_range_m * 0.7:
+            scale = preferred_range_m / max(pdist, 0.01)
+            tx = px + (mx - px) * scale
+            ty = py + (my - py) * scale
+        else:
+            tx, ty = px, py
+    else:
+        tx, ty = px, py
+
+    dx, dy = tx - mx, ty - my
+    d = math.hypot(dx, dy)
+    if d > 0.001:
+        speed = mspeed * dt
+        factor = min(speed / d, 1.0)
+        mx += dx * factor
+        my += dy * factor
+    return (mx, my)
+
+
+def project_target_position(
+    target,
+    cast_time: float,
+    tick_size: float,
+    player_x: float,
+    player_y: float,
+) -> tuple[float, float]:
+    """Forward-integrate `target`'s position over the cast window (math note §3.1).
+
+    Returns the projected (x, y) at cast completion, re-running the SAME motion model
+    the world uses. The player position is held fixed at (player_x, player_y) over the
+    window (the player is committing/rooted; a competent floor does not model its own
+    future motion for a wind-up it is about to commit to). Duration bound: this is the
+    "one extrapolation" the addendum names — steps = round(cast_time/tick_size), sparse
+    (one per wind-up initiation candidate).
+    """
+    steps = int(round(cast_time / tick_size)) if tick_size > 0 else 0
+    mx, my = float(target.x), float(target.y)
+    behavior = target.preferred_behavior or "melee_aggressive"
+    prng = float(getattr(target, "preferred_range_m", 4.0))
+    mspeed = float(target.movement_speed)
+    for _ in range(steps):
+        mx, my = _one_step_mob_motion(
+            mx, my, mspeed, behavior, prng, player_x, player_y, tick_size
+        )
+    return (mx, my)
+
+
+# ── Forced-break trailing-damage ring (F-1b; §2.4; O(1)/event) ────────────────
+
+def ring_push(ring: list, elapsed: float, dmg: float, window_s: float) -> None:
+    """Append an incoming-damage event and evict entries older than the window.
+
+    O(1) amortized: appends the newest, evicts the front while stale. Only ever
+    called while the player is channeling (the engine gates the call), so the
+    non-channel path is allocation-free (perf §8).
+    """
+    ring.append((elapsed, dmg))
+    cutoff = elapsed - window_s
+    # evict from the front (oldest first) while stale
+    i = 0
+    n = len(ring)
+    while i < n and ring[i][0] < cutoff:
+        i += 1
+    if i > 0:
+        del ring[:i]
+
+
+def ring_sum(ring: list, elapsed: float, window_s: float) -> float:
+    """Sum incoming damage within the trailing window (evict-then-sum)."""
+    cutoff = elapsed - window_s
+    return sum(d for (t, d) in ring if t >= cutoff)
+
+
+def forced_break_triggered(ring: list, elapsed: float, c: Commitment, max_hp: float) -> bool:
+    """Σ(incoming over trailing W) ≥ Y% max-HP forces a channel break (§2.4)."""
+    if max_hp <= 0:
+        return False
+    return ring_sum(ring, elapsed, c.forced_break_window_s) >= c.forced_break_pct * max_hp
