+"""
+e4_commitment_sim_consumer_smoke_2026_07_11.py — E4 PHASE-2 sim-consumer verdict instrument.
+
+gamora, 2026-07-11 (gamora/v-commitment-axis-4). Math note:
+    simulation/math/commitment-axis-e4-sim-consumer-2026-07-11.md
+Shared math note (CLOSED): generation/math/commitment-axis-e4-2026-07.md.
+
+This is the #2-FF verdict instrument + the MANDATORY cross-seam round-trip smoke (dispatch §7,
+Principle 6). It exercises the emitter→sim boundary on emitted-for-real skills (NOT hand-built
+packets), consumes them through the cast-state machine, and asserts:
+
+  RT (round-trip): every mechanical [M] field the emitter writes is CONSUMED at the sim boundary
+    and a consumed value round-trips to the SAME number emitted (drain_rate / tick_interval /
+    cast_time / commitment_bin). FAIL if any [M] field is absent/mistyped/unconsumed OR round-
+    trips to a different number.
+  BI (byte-identity guard): a SNAP-grade kit leaves the cast-state machine at "idle" for the whole
+    fight AND produces the degenerate telemetry (all E4 fields None/0) → the E4 path is inert →
+    byte-identical to pre-E4 BY CONSTRUCTION. (The full A/B vs the git-stashed pre-E4 tree is the
+    companion harness e4_byte_identity_ab_2026_07_11.py.)
+  WU (wind-up mechanics): a wind-up kit initiates → commits (cast_time window) → resolves at
+    completion; whiffs against a departing target (motion-whiff); telemetry completion/whiff land.
+  CH (channel mechanics): a channel kit drains per tick, ramps, force-breaks under lethal pressure,
+    exhausts a bound pool; telemetry forced_break/drain_exhaustion/sustain_uptime land.
+  C18 (criterion 18): blind-vs-competent Δc_wind report — the calibration-honesty receipt.
+
+Run: python -m reincarnated.simulation.notes.e4_commitment_sim_consumer_smoke_2026_07_11
+"""
+from __future__ import annotations
+
+import sys
+import time
+
+from reincarnated.generation.per_skill_emitter import emit_skills_for_kit, SkillEmissionConfig
+from reincarnated.simulation.spatial_gauntlet import commitment_state_machine as csm
+from reincarnated.simulation.spatial_gauntlet.spatial_engine import (
+    run_spatial_fight, SpatialFightEngine,
+)
+from reincarnated.simulation.spatial_gauntlet.arena import ALL_SCENARIOS
+
+
+# ── skill emission (production emitter half — e4d682e) ────────────────────────
+
+def _emit_kit(commitment: str, element="fire", amp="spiky", attr="strength", rng="close"):
+    """Emit a real kit's skills via the landed E4 emitter for a chosen commitment bin."""
+    # flat×wind-up is a hard-cut coupling; pick a coupling-legal amplitude per bin.
+    if commitment == "channel":
+        amp = "flat"   # spiky×channel is hard-cut; flat×channel is legal
+        rng = "medium"
+        attr = "intelligence"
+    cfg = SkillEmissionConfig(
+        character_id=f"E4_{commitment}", element=element, bc_attribute=attr,
+        bc_amplitude=amp, bc_commitment=commitment, bc_range=rng,
+    )
+    return emit_skills_for_kit(cfg)
+
+
+def _class_dict(commitment: str) -> dict:
+    """A minimal projection-path class_dict carrying emitted E4 skills. The state machine reads the
+    skill dict fields (commitment_bin/cast_time/...) — the projection path exercises the machine
+    fully; the resolver runs its flat fallback for damage (byte-identity of the machine is what we
+    test, not the damage magnitude)."""
+    skills = [s.model_dump() for s in _emit_kit(commitment)]
+    return {
+        "id": f"E4_{commitment}_kit",
+        "vitality": 20, "strength": 20, "intelligence": 20, "dexterity": 20, "wisdom": 20,
+        "movement_speed": 5.75,
+        "skills": skills,
+    }
+
+
+def _fight(commitment: str, scenario_id="open_arena", n=6, seed=4242, blind=False,
+           damage_modifier=1.0, mob_mutate=None, drain_override=None, hp_mult=None):
+    """Run a gauntlet slice. mob_mutate(mob_dict) lets a regime tune mob behavior (mobility);
+    damage_modifier low keeps the projection-path fight ALIVE long enough for pressure to
+    express (the flat-fallback one-shots at dm=1.0 — an instrument property of the projection
+    path, NOT the machine; the production cert uses resolver-mitigated damage)."""
+    scenario = ALL_SCENARIOS[scenario_id]
+    from reincarnated.simulation.gauntlet_four_family_metrology_driver import _build_standard_mob_dicts
+    mob_dicts = _build_standard_mob_dicts(scenario)
+    if mob_mutate is not None:
+        for m in mob_dicts:
+            mob_mutate(m)
+    cd = _class_dict(commitment)
+    if drain_override is not None:
+        for s in cd["skills"]:
+            if s.get("commitment_bin") == "channel":
+                s["drain_rate"] = drain_override
+    hp_multipliers = [hp_mult] * len(mob_dicts) if hp_mult is not None else None
+    return run_spatial_fight(
+        scenario=scenario, class_dict=cd, mob_dicts=mob_dicts,
+        n_fights=n, session_id=f"e4_smoke_{commitment}", base_seed=seed,
+        season_id="e4-commitment-smoke", player_class=None, damage_modifier=damage_modifier,
+        e4_blind_pilot=blind, hp_multipliers=hp_multipliers,
+    )
+
+
+def _kite(m):
+    m["preferred_behavior"] = "ranged_kite"
+    m["movement_speed"] = 9.0
+    m["range_profile_redistribution"] = {"close": 0.0, "medium": 0.0, "long": 1.0}
+
+
+def main() -> int:
+    fails: list[str] = []
+
+    # ── RT: round-trip field consumption + identity (emitter→sim boundary) ──
+    print("== RT: emitter→sim round-trip (mechanical [M] fields) ==")
+    for bin_ in ("snap", "wind-up", "channel"):
+        skills = [s.model_dump() for s in _emit_kit(bin_)]
+        # find the primary attack (modulated slot carrying the bin)
+        atk = next((s for s in skills if s.get("commitment_bin") == bin_), None)
+        assert atk is not None, f"RT: no modulated {bin_} slot emitted"
+        c = csm.read_commitment(atk)   # the SIM's consumer read
+        # round-trip identity on the [M] numbers
+        if c.bin != atk["commitment_bin"]:
+            fails.append(f"RT {bin_}: bin round-trip {c.bin} != {atk['commitment_bin']}")
+        if abs(c.cast_time - float(atk["cast_time"])) > 1e-12:
+            fails.append(f"RT {bin_}: cast_time round-trip {c.cast_time} != {atk['cast_time']}")
+        if bin_ == "channel":
+            for k, got in (("tick_interval_seconds", c.tick_interval_s),
+                           ("drain_rate", c.drain_rate),
+                           ("forced_break_pct", c.forced_break_pct),
+                           ("forced_break_window_s", c.forced_break_window_s),
+                           ("ramp_n_ticks", c.ramp_n_ticks)):
+                emitted = atk.get(k)
+                if emitted is None:
+                    fails.append(f"RT channel: [M] field {k} ABSENT at sim boundary")
+                elif abs(float(got) - float(emitted)) > 1e-12:
+                    fails.append(f"RT channel: {k} round-trip {got} != {emitted}")
+        print(f"  {bin_:8} bin={c.bin} cast_time={c.cast_time} "
+              f"drain={c.drain_rate} tick={c.tick_interval_s} move_policy={c.move_policy}")
+    print("  RT:", "PASS" if not [f for f in fails if f.startswith('RT')] else "FAIL")
+
+    # ── BI: byte-identity guard — a snap kit leaves the machine INERT ──
+    print("== BI: byte-identity guard (snap = degenerate, machine never fires) ==")
+    raw = _fight("snap")
+    frs = raw["fight_results"]
+    bi_ok = all(
+        r.completion_rate is None and r.whiff_rate is None
+        and r.forced_break_count == 0 and r.move_cancel_count == 0
+        and r.drain_exhaustion_events == 0 and r.sustain_uptime is None
+        and r.damage_taken_while_committed == 0.0
+        for r in frs
+    )
+    if not bi_ok:
+        fails.append("BI: snap kit produced non-degenerate E4 telemetry (machine fired on snap!)")
+    print(f"  snap fights={len(frs)} all-degenerate-telemetry={bi_ok} → "
+          f"{'PASS' if bi_ok else 'FAIL'}")
+
+    # ── PF: pilot-floor projection tracks the motion model (unit-level; §3.1) ──
+    print("== PF: pilot-floor projection tracks the live motion model (§3.1) ==")
+    class _Flee:
+        x = 5.0; y = 0.0; movement_speed = 14.0
+        preferred_behavior = "hit_and_run"; preferred_range_m = 12.0
+    class _Chase:
+        x = 5.0; y = 0.0; movement_speed = 4.0
+        preferred_behavior = "melee_aggressive"; preferred_range_m = 2.0
+    flee = csm.project_target_position(_Flee(), 0.8, 0.1, 0.0, 0.0)
+    chase = csm.project_target_position(_Chase(), 0.8, 0.1, 0.0, 0.0)
+    print(f"  fleeing target (5,0) → projected {tuple(round(v,2) for v in flee)} (moves AWAY, x grows)")
+    print(f"  approaching target (5,0) → projected {tuple(round(v,2) for v in chase)} (moves TOWARD, x shrinks)")
+    if not (flee[0] > 5.0 and chase[0] < 5.0):
+        fails.append("PF: projection does not track the motion model (fleeing should grow x, "
+                     "approaching should shrink x)")
+    print("  PF:", "PASS" if not [f for f in fails if f.startswith('PF')] else "FAIL")
+
+    # ── WU: wind-up mechanics (initiate/commit/resolve/whiff/telemetry) ──
+    # Mobility regime (kiting mobs) so wind-ups genuinely whiff. dm=0.02 keeps the projection-path
+    # fight alive (dm=1.0 flat-fallback one-shots → no regime expression, an instrument property).
+    print("== WU: wind-up mechanics (motion-whiff + completion telemetry; kiting mobility regime) ==")
+    raw = _fight("wind-up", scenario_id="open_arena", n=5, damage_modifier=0.02, mob_mutate=_kite)
+    frs = raw["fight_results"]
+    wu_active = [r for r in frs if r.completion_rate is not None]
+    if not wu_active:
+        fails.append("WU: no wind-up was initiated across the gauntlet (machine never fired)")
+    else:
+        cr = [r.completion_rate for r in wu_active]
+        whiffed = any((r.whiff_rate or 0) > 0 for r in wu_active)
+        print(f"  wind-up fights with initiations: {len(wu_active)}/{len(frs)}; "
+              f"completion_rate range [{min(cr):.3f}, {max(cr):.3f}]; motion-whiff expressed={whiffed}")
+        if any(not (0.0 <= r.completion_rate <= 1.0) for r in wu_active):
+            fails.append("WU: completion_rate out of [0,1]")
+        if not whiffed:
+            fails.append("WU: no whiff in a kiting mobility regime (motion-whiff not expressing — "
+                         "the fake-risk sign for wind-up)")
+    print("  WU:", "PASS" if not [f for f in fails if f.startswith('WU')] else "FAIL")
+
+    # ── CH-lethality: forced-break + lock-exposure (boss_with_adds; heavy incoming) ──
+    print("== CH-lethality: forced-break + lock-exposure (boss_with_adds lethality regime) ==")
+    raw = _fight("channel", scenario_id="boss_with_adds", n=4, damage_modifier=0.02)
+    frs = raw["fight_results"]
+    fb = sum(r.forced_break_count for r in frs)
+    dtc = sum(r.damage_taken_while_committed for r in frs)
+    print(f"  forced_break_total={fb}; dmg_taken_while_committed={dtc:.1f} "
+          f"(rooted channeler exposed → both express under lethal pressure)")
+    if fb <= 0:
+        fails.append("CH-lethality: zero forced breaks in a lethality regime (F-1b rule not firing)")
+    if dtc <= 0.0:
+        fails.append("CH-lethality: zero damage_taken_while_committed (rooted lock exposure not "
+                     "expressing — the fake-risk sign for channel)")
+    print("  CH-lethality:", "PASS" if not [f for f in fails if f.startswith('CH-lethality')] else "FAIL")
+
+    # ── CH-drain: exhaustion binds a pool (attrition; drain > net regen) ──
+    # A high drain (400/s vs pool 100) makes the pool bind in ~1 tick → drain_exhaustion_events +
+    # sustain_uptime<1.0 (the overflow-binding VISIBILITY, §6.4 — the "free lock" HARD-FAIL signal
+    # is instrument-visible). dm≈0 + tanky mobs keeps the channel from clearing (so it drains).
+    print("== CH-drain: exhaustion binds the pool (drain-economics visibility, §6.4) ==")
+    raw = _fight("channel", scenario_id="open_arena", n=3, damage_modifier=0.0001,
+                 drain_override=400.0, hp_mult=5.0)
+    frs = raw["fight_results"]
+    ex = sum(r.drain_exhaustion_events for r in frs)
+    su = [r.sustain_uptime for r in frs if r.sustain_uptime is not None]
+    print(f"  drain_exhaustion_total={ex}; sustain_uptime range "
+          f"[{min(su):.3f}, {max(su):.3f}] (bound pool → uptime<1.0, exhaustion>0)")
+    if ex <= 0:
+        fails.append("CH-drain: zero exhaustion with drain 400/s vs pool 100 (drain not binding)")
+    if any(not (0.0 <= s <= 1.0) for s in su):
+        fails.append("CH-drain: sustain_uptime out of [0,1]")
+    print("  CH-drain:", "PASS" if not [f for f in fails if f.startswith('CH-drain')] else "FAIL")
+
+    # ── C18: blind-vs-competent Δc_wind (criterion 18 calibration-honesty receipt) ──
+    print("== C18: blind-vs-competent Δc_wind (pilot-floor honesty receipt) ==")
+    comp = _fight("wind-up", scenario_id="open_arena", n=5, damage_modifier=0.02, mob_mutate=_kite, blind=False)
+    blnd = _fight("wind-up", scenario_id="open_arena", n=5, damage_modifier=0.02, mob_mutate=_kite, blind=True)
+    def _mean_cwind(raw):
+        rs = [r.completion_rate for r in raw["fight_results"] if r.completion_rate is not None]
+        return sum(rs) / len(rs) if rs else None
+    c_comp, c_blind = _mean_cwind(comp), _mean_cwind(blnd)
+    if c_comp is None or c_blind is None:
+        print(f"  (competent={c_comp}, blind={c_blind}) — one arm had no initiations. Reported, non-fatal.")
+    else:
+        delta = c_comp - c_blind
+        print(f"  c_wind competent={c_comp:.4f}  blind={c_blind:.4f}  Δ={delta:+.4f}")
+        print(f"  NOTE: in this MELEE-CLOSE smoke the player AI closes to attack range before firing,")
+        print(f"  so targets are in-template at INITIATION for both pilots and Δ≈0 is EXPECTED here.")
+        print(f"  The Δ signal lands in the production RANGED-mobility cert (a ranged wind-up kit vs")
+        print(f"  kiting mobs at range — the classic whiff regime the competent floor can pre-avoid).")
+        print(f"  The projection LOGIC is proven working by PF above (fleeing→x grows, approach→x shrinks).")
+
+    # ── PERF: fights/s with the machine live (criterion 19 gate; report only here) ──
+    print("== PERF: fights/s with cast-state machine live (report; hard gate in A/B harness) ==")
+    t0 = time.perf_counter()
+    _fight("wind-up", scenario_id="open_arena", n=20, damage_modifier=0.02)
+    dt = time.perf_counter() - t0
+    fps = 20.0 / dt if dt > 0 else float("inf")
+    print(f"  wind-up 20 fights in {dt:.2f}s → {fps:.1f} fights/s "
+          f"({'≥30 OK' if fps >= 30 else 'BELOW 30 — investigate'})")
+
+    print()
+    if fails:
+        print("RESULT: FAIL")
+        for f in fails:
+            print("  -", f)
+        return 1
+    print("RESULT: PASS (RT + BI + WU + CH green; C18 + PERF reported)")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
