+## ============================================================================
+## ⚑ WW-8a — THE CALIBRATION PROBE, PORTED FROM `kc2_cpb_clip.gd`. A RULER.
+##
+## ⚑ WHY IT IS HERE AS WELL AS IN THE ARENA. The arena fighter and THIS rig's
+##   player werewolf are of nearly equal world height and read 0.665x apart in
+##   screen register under the SAME camera language. A known 2.000 m geometry
+##   rendered in BOTH rigs lets a downstream measurement say which side of the
+##   fence the mislabeled term sits on. This rig is the REFERENCE side.
+##
+## ⚑ IT MEASURES NOTHING AND PROJECTS NOTHING. Build, read the height back off
+##   the scene, print. The screen extent is galadriel's cell (WW-8b).
+##
+## ⚑ `_pl_ring_root` IS THE PRECEDENT AND THE PATTERN: a Node3D parented to the
+##   scene root and repositioned to `_pl_player_w` inside `_pl_cam_update`, so
+##   probe and camera share ONE ground read. Parenting under the player body
+##   would inherit the body's scale — one of the very terms under test.
+##
+## ⚑ ADDITIVE ONLY. Absent `--probe-calib on` no node is created, no print fires,
+##   and this rig renders the bytes it has always rendered.
+## ============================================================================
+func _ww8a_build_calib_probe() -> void:
+	var mesh := BoxMesh.new()
+	mesh.size = Vector3(WW8A_PROBE_XZ_M, WW8A_PROBE_H_M, WW8A_PROBE_XZ_M)
+	var mat := StandardMaterial3D.new()
+	mat.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
+	mat.albedo_color = WW8A_PROBE_HUE
+	mat.disable_fog = true
+	mat.disable_receive_shadows = true
+	mesh.material = mat
+	_ww8a_probe = MeshInstance3D.new()
+	_ww8a_probe.name = "Ww8aCalibProbe"
+	_ww8a_probe.mesh = mesh
+	_ww8a_probe.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
+	_ww8a_probe.gi_mode = GeometryInstance3D.GI_MODE_DISABLED
+	add_child(_ww8a_probe)
+	# ---- THE READ-BACK. Height is invariant under the per-frame translation in
+	#      `_pl_cam_update`, so it is asserted HERE, once, off the built scene.
+	var wa: AABB = _ww8a_probe.global_transform * _ww8a_probe.get_aabb()
+	var h_err: float = absf(wa.size.y - WW8A_PROBE_H_M)
+	var ok: bool = h_err < WW8A_PROBE_TOL_M
+	print("[wr2] ⚑ WW-8a CALIBRATION PROBE — a KNOWN %.3f m geometry at the player's own "
+		% WW8A_PROBE_H_M
+		+ "ground point, under this rig's player_lock camera. NO MEASUREMENT AND NO "
+		+ "PROJECTION IS MADE BY THIS HARNESS; the screen extent is galadriel's (WW-8b).")
+	print("[wr2] WW-8a probe: parent = scene root (identity), material UNSHADED, albedo "
+		+ "(%.3f, %.3f, %.3f), fog DISABLED on material, shadow casting OFF, GI disabled, "
+		% [WW8A_PROBE_HUE.r, WW8A_PROBE_HUE.g, WW8A_PROBE_HUE.b]
+		+ "footprint %.3f x %.3f m" % [WW8A_PROBE_XZ_M, WW8A_PROBE_XZ_M])
+	print("[wr2] WW-8a probe READ-BACK world AABB: position (%.10f, %.10f, %.10f) m  "
+		% [wa.position.x, wa.position.y, wa.position.z]
+		+ "size (%.10f, %.10f, %.10f) m" % [wa.size.x, wa.size.y, wa.size.z])
+	print("[wr2] WW-8a probe HEIGHT ASSERTION: read-back %.10f m vs declared %.10f m"
+		% [wa.size.y, WW8A_PROBE_H_M]
+		+ " — |err| %.12f m; tol %.12f m — VERDICT %s"
+		% [h_err, WW8A_PROBE_TOL_M, ("PASS" if ok else "FAIL")])
+	if not ok:
+		push_error("[wr2] WW-8a HALT — probe read-back height %.10f m != %.10f m (|err| %.12f m, "
+			% [wa.size.y, WW8A_PROBE_H_M, h_err]
+			+ "tol %.12f m). A probe of unverified height is worse than no probe."
+			% WW8A_PROBE_TOL_M)
+		get_tree().quit(11)
