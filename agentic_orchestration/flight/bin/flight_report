REPO_ROOT = os.path.dirname(AO_DIR)
FACTORY_DIR = os.path.join(AO_DIR, "factory")
sys.path.insert(0, FLIGHT_DIR)

import schema  # noqa: E402
import tape as tapemod  # noqa: E402

SIBLING_REPOS = ("reincarnated-collaboration", "reincarnated-engine",
                 "reincarnated-demo", "reincarnated-loadout", "reincarnated-godot")

AGENT_LANES = {"claude-agent", "claude-subagent"}

# F-2 SLA (RULED): agent dispatches amber 48 h / red 7 d.
AGENT_AMBER_S = 48 * 3600
AGENT_RED_S = 7 * 86400
# F-2 SLA: scripted jobs amber at 2× / red at 5× their class median duration.
SCRIPTED_AMBER_MULT = 2
SCRIPTED_RED_MULT = 5

GREEN, AMBER, RED = "\U0001F7E2", "\U0001F7E1", "\U0001F534"

