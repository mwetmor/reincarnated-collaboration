{
  "definitions": {
    "cell": "Matrix animation_DIR key; cells ordered by direction S SW W NW N NE E SE, then idle walk run jump cast.",
    "n_frames": "Count of animation_DIR_NN.png files in the cell animation/direction frame directory, ordered by numeric NN; rest excluded.",
    "fps_out": "Unmodified top-level fps_out from the cell registration.json, in frames per second.",
    "G6_literal": "g6_seam.evaluate(frames) g6_seam value: last-to-first mean absolute RGB difference over all canvas pixels and channels after Pillow alpha compositing onto RGB (20,25,34), display RGB 0..255.",
    "G6_literal_internal_min": "g6_seam.evaluate(frames) g6_seam threshold quantity: minimum internal adjacent-pair canvas RGB MAD, excluding the last-to-first seam; report only.",
    "G6b": "g6_seam.evaluate(frames) g6b value: last-to-first mean absolute RGB difference over all canvas pixels and channels after Pillow alpha compositing onto RGB (20,25,34), display RGB 0..255.",
    "G6b_internal_median": "g6_seam.evaluate(frames) g6b threshold quantity: median internal adjacent-pair canvas RGB MAD, excluding the last-to-first seam; report only.",
    "G6c": "Walk/run only: frozen g6_seam.g6c(frames, animation=\"walk\") value, seam canvas RGB MAD divided by half-cycle pair (N/2-1,N/2) canvas RGB MAD; same calculation for run via the accepted walk argument; 0/0=1, positive/0=null; other animations=null.",
    "G6c_ratio_infinite": "For walk/run, ratio_infinite from frozen G6c notes (positive seam MAD and zero half-cycle MAD); other animations or unevaluable result=null.",
    "G1_max": "Maximum over animation frames of g1_height.evaluate(frame, cell rest).value = abs(H_frame/H_rest-1), with inclusive alpha>=128 bbox heights in pixels; fraction, not percent.",
    "closure_mad": "Mean absolute straight RGB difference over RGB channels and pixels with max(alpha_first,alpha_last)>=128; first=frame 0 for idle/walk/run and cell rest for jump/cast, last=frame N-1; no compositing, weighting, or alignment, display RGB 0..255.",
    "rim_mean": "Arithmetic mean over all animation frames of frozen matte_quality.rim_luma_excess value with default bg=(58,63,74): Rec.709 display composite luma of 0<alpha<255 band minus alpha=255 ring at Euclidean distance 1..3 px; null if any frame is unevaluable.",
    "motion_range_H": "(Maximum minus minimum alpha>=128 bbox top row across animation frames)/H_rest, with the same cell rest and inclusive height used by G1; fraction.",
    "lateral_range_H": "(Maximum minus minimum alpha>=128 bbox centre-x across animation frames)/H_rest; centre-x=(leftmost+rightmost pixel index)/2 and the same cell rest height used by G1; fraction.",
    "H_rest": "Inclusive alpha>=128 bbox height in pixels of the cell frames/rest/DIR/rest_DIR.png; shared denominator for G1_max and both motion ranges.",
    "null_policy": "Unavailable quantities are JSON null and CSV empty; G6c is inapplicable outside walk/run; no numeric quantity is a verdict.",
    "missing": "Parsed contents of input cells/missing.json copied unchanged."
  },
