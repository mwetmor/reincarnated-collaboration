{
  "definitions": {
    "cell": "Matrix key <animation>_<DIR>; rows ordered by S SW W NW N NE E SE, then idle walk run jump cast; only cells with named frame inputs are included.",
    "n_frames": "Count of animation PNG frames in the named cell, ordered by numeric filename suffix; rest is excluded.",
    "fps_out": "Playback frames per second copied from the cell registration.json top-level fps_out.",
    "G6b": "Frozen g6_seam.evaluate(frames) g6b value: last-to-first RGB MAD over the entire canvas after PIL alpha compositing on RGB (20,25,34), in display RGB units 0..255; this is raw MAD, not a ratio, and uses animation endpoints even for one-shots.",
    "G6b_median_internal_mad": "Frozen g6_seam.evaluate(frames) g6b threshold: median full-canvas composited RGB MAD across internal adjacent animation-frame pairs; retained as a descriptive comparator only.",
    "G6_literal_min_internal_mad": "Frozen g6_seam.evaluate(frames) g6_seam threshold: minimum full-canvas composited RGB MAD across internal adjacent animation-frame pairs; its measured seam value is identical to G6b.",
    "G6c": "For walk/run only, frozen g6_seam.g6c(frames, animation=\"walk\") value: full-canvas composited seam MAD (N-1,0) divided by half-cycle homologue MAD (N/2-1,N/2); the walk-only function mode is used for both gait types as requested; 0/0 is 1, positive/0 is null with G6c_ratio_infinite true; other animations are null.",
    "G6c_homologue_mad": "Walk/run half-cycle homologue MAD from frozen g6c notes, in full-canvas composited RGB units 0..255; null for other animations.",
    "G6c_ratio_infinite": "Frozen g6c ratio_infinite flag for walk/run; null when G6c is not applicable or unevaluable.",
    "G1_max": "Maximum g1_height.evaluate(frame, cell rest) value across all animation frames: abs(H_frame/H_rest - 1), with alpha >=128 inclusive bbox height; null if any required measurement is unavailable.",
    "closure_mad": "Mean absolute straight RGB difference across all three channels and pixels where max(alpha_first,alpha_last)>=128; first=animation frame 0 for idle/walk/run, first=cell rest for jump/cast, last=animation frame N-1; no compositing, alpha weighting, alignment or masking of either RGB operand; units 0..255; empty union gives null.",
    "rim_mean": "Arithmetic mean over all frames of frozen matte_quality.rim_luma_excess with default background (58,63,74): partial-alpha composite Rec.709 display luma minus opaque interior-ring mean at Euclidean distance 1..3 px; signed luma units 0..255; null if any frame is unevaluable.",
    "motion_range_H": "(Maximum minus minimum alpha>=128 bbox top row across animation frames)/H_rest; rest supplies only the denominator; null for empty required alpha support.",
    "lateral_range_H": "(Maximum minus minimum alpha>=128 bbox center-x across animation frames)/H_rest, with center-x=(xmin+xmax_inclusive)/2; rest supplies only the denominator; null for empty required alpha support.",
    "H_rest": "Cell-local rest image alpha>=128 bbox height in pixels (ymax_inclusive-ymin+1).",
    "notes": "Per-cell measurement caveats only; no verdicts; JSON null is represented by the literal text null in CSV."
  },
