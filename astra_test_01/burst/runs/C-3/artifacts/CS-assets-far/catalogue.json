  "methods": {
    "matte": "frozen extract(edge_mode=clamp, preserve_particles=True); temporary 12-px green pad only on diagnosed matte retry, cropped off before resizing",
    "resize": "uniform 1/scale, Pillow RGBa premultiplied LANCZOS then RGBA",
    "registration": "all alpha>=200 pixels; mean absolute RGB channel difference; integer shifts +/-10; flag Euclidean shift norm >3 or residual >22",
    "split": "alpha>=32 support, radius-3 Euclidean grouping dilation, 8-connected labeling; border test on dilated group; area count on original support; preserve owned nonzero-alpha fringe",
    "opaque": "alpha>=128, matching frozen loader",
    "anchor": "mean x pixel index across last six occupied opaque rows; maximum opaque y+1",
    "shadow": "Rec.709 luminance of supplied RGB values; scipy Gaussian sigma 11 px reflect; threshold and green exclusion before sigma 2 px softening; 8-bit alpha saved",
    "rebuild": "BEFORE*(1-s), then straight-alpha assets in ascending anchor-y; each panel 768x512",
    "footprints": "60x40 placeholder ellipse; conductor derives shaped footprints"
  }
