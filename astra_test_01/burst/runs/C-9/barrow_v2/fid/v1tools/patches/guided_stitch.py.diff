+    return m
+def _step_along(ctx, new):
+    # ctx, new: (L, BAND, 3) bands either side of the boundary (L along it) -> (L, 3) step, smoothed along the boundary
+    mc, mn_ = _icesnow(ctx), _icesnow(new)
