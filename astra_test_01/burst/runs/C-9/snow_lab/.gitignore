# C-9 T10-1b SNOW LAB -- what is committed here, and what is not.
#
# COMMITTED: the four files this run AUTHORED.
#   godot/scripts/snow_field.gd   the module (class_name SnowField) and its shader
#   godot/scripts/snow_lab.gd     the sandbox scene that exercises it
#   godot/tools/shot_snow.gd      the measurement + capture harness
#   godot/tools/probe_pipe.gd     the probe that proved frames can go straight into ffmpeg
#   godot/tools/parse_check.gd    a parse gate
#   godot/project.godot, godot/scenes/snow_lab.tscn
#
# NOT COMMITTED, deliberately:
#   .godot/      100 MB of import cache; regenerated by --headless --import
#   models/      78 MB of GLBs COPIED from runs/C-9/cliffside3d/godot/. They are UNTRACKED
#                at their source too, so committing them here would put 78 MB of binary into
#                git that the project has chosen to keep out of it -- and would fork them:
#                two copies that can drift with nothing saying which is authoritative.
#   textures/, data/, and the copied scripts (paint_stack.gd, knight.gd, gear.gd, world.gd)
#                are likewise copies. knight.gd and gear.gd in particular MUST stay identical
#                to their originals -- the module is built to drop in beside them unchanged --
#                so a second committed copy is a liability, not a backup.
#
# TO RECONSTITUTE the sandbox from a clean checkout (SRC is the Barrow project):
#   REPO=~/Games/reincarnated-collaboration
#   SRC=astra_test_01/burst/runs/C-9/cliffside3d/godot
#   LAB=$REPO/astra_test_01/burst/runs/C-9/snow_lab/godot
#   mkdir -p $LAB/{data,textures/barrow,models/gear,models/barrow}
#   # tracked text + data come from git HEAD, NOT the worktree: the Barrow's paint_stack.gd
#   # and barrow_world.gd are edited live by the integration session.
#   for p in scripts/paint_stack.gd scripts/knight.gd scripts/gear.gd scripts/world.gd \
#            data/character.json data/gear_manifest.json data/barrow_assets.json \
#            data/barrow_scene_a.json data/landmarks.json; do
#     git -C $REPO show HEAD:$SRC/$p > $LAB/$p
#   done
#   # binaries are untracked at the source, so they come off disk
#   cp $REPO/$SRC/textures/barrow/snow.png            $LAB/textures/barrow/
#   cp $REPO/$SRC/models/gear/nb-body.glb             $LAB/models/gear/
#   cp $REPO/$SRC/models/gear/nb-body_texture_AB.png  $LAB/models/gear/
#   for g in axe shield helmet byrnie mantle bracers; do
#     cp $REPO/$SRC/models/gear/$g.glb $LAB/models/gear/
#     cp $REPO/$SRC/models/gear/${g}_Color_*.jpg $LAB/models/gear/
#   done
#   cp $REPO/$SRC/models/barrow/stone_tall.glb $REPO/$SRC/models/barrow/rock_large.glb $LAB/models/barrow/
#   cp $REPO/$SRC/models/barrow/stone_tall_Color_*.jpg $REPO/$SRC/models/barrow/rock_large_Color_*.jpg $LAB/models/barrow/
#   /Applications/Godot.app/Contents/MacOS/Godot --headless --path $LAB --import
#
# NOTE ON THE COPIES: git HEAD's paint_stack.gd has NO adopt_prop / ground_material /
# load_tile (they landed in the worktree during this run), and its POST_SHADER still uses the
# FIRST-difference depth edge. snow_lab.gd carries a local adopt_prop and can swap in the
# second-difference operator; see set_ink_operator().

.godot/
models/
textures/
data/
godot/.godot/
godot/models/
godot/textures/
godot/data/
godot/scripts/paint_stack.gd
godot/scripts/paint_stack.gd.uid
godot/scripts/knight.gd
godot/scripts/knight.gd.uid
godot/scripts/gear.gd
godot/scripts/gear.gd.uid
godot/scripts/world.gd
godot/scripts/world.gd.uid
*.uid
