+
+func _step_shake(dt: float) -> void:
+	"""THE IMPACT'S SHAKE: 7 px, gone in 0.32 s, on the camera's offsets (_process)."""
+	if _shake_t < 0.0:
+		shake_px = Vector2.ZERO
