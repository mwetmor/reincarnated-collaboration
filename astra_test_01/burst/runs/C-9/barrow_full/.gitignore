# C-9 T10-2 barrow_full sandbox: generated, heavy, or machine-local. GLB and PNG are already
# ignored repo-wide under astra_test_01/; these are the rest.
godot/.godot/
godot/**/*.import
godot/models/**/*.jpg
godot/models/**/*.jpeg
app/
captures/
*.uid
godot/data/*.bin
work/
# the painted Barrow's data: regenerated by tools/paint_world_prep.py (manifest.json + heather.json are kept)
godot/data/painted/*.bin
godot/data/painted/bakes/
godot/data/painted_web/*.bin
godot/data/painted_web/bakes/
web_painted/
# the Fire Ball atlas pages: regenerated by tools/fire_bake_pack.py from the bake (fire_ball.json is kept, sha256 per page)
godot/data/vfx/*/*.bin
# C-9 BV2F ARENA (R-C9-348): the KC2 runtime is REFERENCED, not copied -- a symlink to reincarnated-godot/kc2_runtime
godot/kc2/kc2_runtime
godot/kc2/art_x/
# C-9 BV2F ARENA (R-C9-376): the reused cliffside/en_e2 VFX pack, staged by tools/arena_stage_vfx.py
godot/kc2/vfx_x/
# R-C9-391: the arena web mirror (tools/build_web_arena.sh)
web_arena/
# Native Windows export mirror, package, and verification evidence.
pc_arena/
