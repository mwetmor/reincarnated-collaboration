{
  "type": "object",
  "properties": {
    "RULE": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "faction": {
            "type": "string"
          },
          "scope": {
            "type": "string",
            "enum": [
              "character",
              "prop",
              "environment",
              "vfx",
              "ui"
            ]
          },
          "class": {
            "type": "string",
            "enum": [
              "motif",
              "material",
              "construction",
              "silhouette",
              "palette",
              "plain-budget",
              "light",
              "scale"
            ]
          },
          "statement": {
            "type": "string"
          },
          "placements": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "where": {
                  "type": "string"
                },
                "scale_px": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "count": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "where",
                "scale_px",
                "count"
              ],
              "additionalProperties": false
            }
          },
          "exclusions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "parts_ref": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reference_asset": {
            "type": [
              "string",
              "null"
            ]
          },
          "known_bad": {
            "type": [
              "string",
              "null"
            ]
          },
          "oracle": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "enum": [
                  "O1",
                  "O2",
                  "O3",
                  "O4",
                  "O5",
                  "O6",
                  "O7",
                  "O8",
                  "O9",
                  "JUDGE-only"
                ]
              },
              "threshold": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "inputs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "needs_part_masks": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "threshold",
              "inputs",
              "needs_part_masks"
            ],
            "additionalProperties": false
          },
          "source": {
            "type": "string",
            "enum": [
              "matt-ruling",
              "bible-author",
              "oracle-feedback"
            ]
          },
          "date": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "faction",
          "scope",
          "class",
          "statement",
          "placements",
          "exclusions",
          "parts_ref",
          "reference_asset",
          "known_bad",
          "oracle",
          "source",
          "date",
          "status"
        ],
        "additionalProperties": false
      }
    },
    "PILLARS": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "filter_statement": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "filter_statement"
        ],
        "additionalProperties": false
      },
      "minItems": 2,
      "maxItems": 3
    },
    "PALETTE": {
      "type": "object",
      "properties": {
        "scope": {
          "type": "string"
        },
        "swatches": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          }
        },
        "relation_rules": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "figure_vs_ground": {
                "type": "string"
              },
              "sign": {
                "type": "integer",
                "enum": [
                  -1,
                  1
                ]
              },
              "min_delta": {
                "type": "number"
              }
            },
            "required": [
              "figure_vs_ground",
              "sign",
              "min_delta"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "scope",
        "swatches",
        "relation_rules"
      ],
      "additionalProperties": false
    },
    "PARTS": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "adjacency": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rigidity": {
            "type": "string",
            "enum": [
              "rigid",
              "soft",
              "cloth",
              "hair"
            ]
          },
          "attachment_to": {
            "type": [
              "string",
              "null"
            ]
          },
          "palette_bin": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "properties": {
                  "a": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 2,
                    "maxItems": 2
                  },
                  "b": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 2,
                    "maxItems": 2
                  }
                },
                "required": [
                  "a",
                  "b"
                ],
                "additionalProperties": false
              }
            ]
          },
          "allowed_motifs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "plain": {
            "type": "boolean"
          },
          "mirror_of": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "name",
          "adjacency",
          "rigidity",
          "attachment_to",
          "palette_bin",
          "allowed_motifs",
          "plain",
          "mirror_of"
        ],
        "additionalProperties": false
      }
    },
    "CONSTRUCTION": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "part": {
                "type": "string"
              },
              "terminates_at": {
                "type": "string"
              },
              "statement": {
                "type": "string"
              }
            },
            "required": [
              "part",
              "terminates_at",
              "statement"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "part": {
                "type": "string"
              },
              "closes": {
                "type": "string"
              },
              "statement": {
                "type": "string"
              }
            },
            "required": [
              "part",
              "closes",
              "statement"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "LIGHT": {
      "type": "object",
      "properties": {
        "key_azimuth_deg": {
          "type": "number"
        },
        "key_elevation": {
          "type": [
            "number",
            "null"
          ]
        },
        "fill_ratio": {
          "type": [
            "number",
            "null"
          ]
        },
        "source_count": {
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "key_azimuth_deg",
        "key_elevation",
        "fill_ratio",
        "source_count"
      ],
      "additionalProperties": false
    },
    "SCALE": {
      "type": "object",
      "properties": {
        "canvas_px": {
          "type": "integer",
          "minimum": 0
        },
        "feature_size_px": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        }
      },
      "required": [
        "canvas_px",
        "feature_size_px"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "RULE",
    "PILLARS",
    "PALETTE",
    "PARTS",
    "CONSTRUCTION",
    "LIGHT",
    "SCALE"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bible v0.1"
}
